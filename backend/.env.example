# Run from the repository root with: --env-file backend/.env
# Keep the key on the server only. Both empty = deterministic offline fallback.
OPENAI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=4

# Relative to the working directory; omit to use backend/data/questbridge.sqlite3.
QUESTBRIDGE_DB=backend/data/questbridge.sqlite3
SEED_DEMO=true
# Exact Unity WebGL page origins, comma-separated (no wildcard).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
